# The permanent runtime's own egress rules, applied inside its own network
# namespace by the init containers of statefulset.yaml.example. Copy this
# file, replace every <placeholder>, and create it before the StatefulSet.
#
# These rules were measured in a credential-free diagnostic Pod on the target
# cluster: the link-local metadata address was refused before and after a full
# workflow and a restart, while DNS and public destinations stayed reachable.
# They are the workload's own rules. They do not change the cluster's network
# plugin, they do not restrict which public services may be reached, and an
# accepted manifest is not evidence of enforcement: check both an allowed and
# a forbidden destination from the running Pod (README.md, step 6).
apiVersion: v1
kind: ConfigMap
metadata:
  name: <consumer>-ticket-engine-egress
  namespace: <namespace>
data:
  # <dns-cluster-ip>: the cluster DNS Service address, read with
  #   kubectl -n kube-system get service kube-dns -o jsonpath='{.spec.clusterIP}'
  # It has to be the address the Pod's own /etc/resolv.conf names. Compare it
  # with the nameserver line of any running Pod in the same namespace: a
  # cluster with a node-local DNS cache can hand Pods a link-local address,
  # which the 169.254.0.0/16 rule below would refuse, and then nothing resolves.
  #
  # The rules are applied when the Pod starts. After editing them, apply this
  # ConfigMap and restart the Pod; a syntax error shows as a failing
  # network-v4 or network-v6 init container (kubectl logs ... -c network-v4).
  # Everything private, link-local or multicast is rejected, which includes
  # the cluster's own Service and Pod ranges: this runtime talks to the
  # tracker, the model provider and the delivery service, not to its
  # neighbours or to the node's credential endpoint.
  ipv4.rules: |
    *filter
    :TICKET_EGRESS - [0:0]
    -A TICKET_EGRESS -o lo -j ACCEPT
    # Replies of the status page on 9200 (never a new connection: no SYN), so a
    # load balancer or health check on a private address can be answered.
    -A TICKET_EGRESS -p tcp --sport 9200 ! --syn -j ACCEPT
    -A TICKET_EGRESS -d <dns-cluster-ip> -p udp --dport 53 -j ACCEPT
    -A TICKET_EGRESS -d <dns-cluster-ip> -p tcp --dport 53 -j ACCEPT
    -A TICKET_EGRESS -d 0.0.0.0/8 -j REJECT
    -A TICKET_EGRESS -d 10.0.0.0/8 -j REJECT
    -A TICKET_EGRESS -d 100.64.0.0/10 -j REJECT
    -A TICKET_EGRESS -d 127.0.0.0/8 -j REJECT
    -A TICKET_EGRESS -d 169.254.0.0/16 -j REJECT
    -A TICKET_EGRESS -d 172.16.0.0/12 -j REJECT
    -A TICKET_EGRESS -d 192.168.0.0/16 -j REJECT
    -A TICKET_EGRESS -d 198.18.0.0/15 -j REJECT
    -A TICKET_EGRESS -d 224.0.0.0/4 -j REJECT
    -A TICKET_EGRESS -d 240.0.0.0/4 -j REJECT
    -A TICKET_EGRESS -j RETURN
    -I OUTPUT 1 -j TICKET_EGRESS
    COMMIT
  # Nothing here needs IPv6. Loopback stays available for the controller's own
  # scoped tracker service; every other destination is refused.
  ipv6.rules: |
    *filter
    :TICKET_EGRESS - [0:0]
    -A TICKET_EGRESS -o lo -j ACCEPT
    -A TICKET_EGRESS -p tcp --sport 9200 ! --syn -j ACCEPT
    -A TICKET_EGRESS -j REJECT
    -I OUTPUT 1 -j TICKET_EGRESS
    COMMIT
